# ==============================================================================
# NEBULA 2046 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & Secrets (Change in production!)
JWT_SECRET=nebula_jwt_hyper_secure_quantum_signature_2046_key
SESSION_SECRET=nebula_session_encryption_seed_orbit_alpha_9

# Database Connection
# Default for zero-config immediate local dev is SQLite:
DATABASE_URL="file:./dev.db"
# For Docker / PostgreSQL in production:
# DATABASE_URL="postgresql://nebula:nebula_secure_password_2046@localhost:5432/nebula2046?schema=public"

# Redis Cache & Real-Time Sync (Optional for single instance dev, required for multi-instance cluster)
REDIS_URL="redis://localhost:6379"

# Media Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# WebRTC STUN/TURN Signaling
STUN_SERVER_URL="stun:stun.l.google.com:19302"
# TURN_SERVER_URL="turn:turn.nebula2046.io:3478"
# TURN_USERNAME="nebula"
# TURN_CREDENTIAL="turn_secure_token"

# Optional External AI Provider (NEBULA AI has built-in smart synthesis by default)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o"
